# Copy this file to .env and customize
# Do NOT commit real secrets into source control.

# Flask secret key
SECRET_KEY=change-me

# Admin user credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# SQLite database path (relative to project root)
DATABASE_PATH=shipments.db

# OpenWeather (recommended) - enables live weather in shipment prediction
OPENWEATHER_API_KEY=

# TomTom API key (recommended) - enables traffic-aware route context
# Get one at: https://developer.tomtom.com/
TOMTOM_API_KEY=

# Mapbox style (optional) - overrides the default light style
# Examples:
# MAPBOX_STYLE=mapbox://styles/mapbox/light-v11
# MAPBOX_STYLE=mapbox://styles/mapbox/dark-v11
MAPBOX_STYLE=mapbox://styles/mapbox/light-v11
